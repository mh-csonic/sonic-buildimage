#!/usr/bin/env python3
import argparse
import sys
from pathlib import Path

from personaforge import (
    BuildContractError,
    load_catalog,
    load_manifest,
    resolve_build_contract,
    write_build_outputs,
)
from personaforge.build import validate_config_user


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description="Internal PersonaForge Make helper")
    subparsers = result.add_subparsers(dest="operation", required=True)
    for operation in ("key", "generate"):
        command = subparsers.add_parser(operation)
        command.add_argument("--profile", required=True)
        command.add_argument("--catalog", required=True)
        command.add_argument("--source-commit", required=True)
        command.add_argument("--platform", required=True)
        if operation == "generate":
            command.add_argument("--config-user")
            command.add_argument("--output-dir", required=True)
    return result


def main() -> int:
    arguments = parser().parse_args()
    try:
        manifest = load_manifest(arguments.profile)
        catalog = load_catalog(arguments.catalog)
        contract = resolve_build_contract(
            manifest,
            catalog,
            arguments.source_commit,
            arguments.platform,
            Path(__file__).resolve(),
        )
        if arguments.operation == "key":
            print(contract.build_key)
        else:
            validate_config_user(Path(arguments.config_user) if arguments.config_user else None, contract.settings)
            write_build_outputs(Path(arguments.output_dir), contract, manifest, catalog)
        return 0
    except (OSError, ValueError) as exc:
        print("personaforge-build: {}".format(exc), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
